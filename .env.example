# Mixed-vendor fleet config for the `multivendor` e2e (copy to `.env`, fill in).
# `.env` is gitignored — it holds the Securosys PIN + the SoftHSM PIN.
#
# The fleet is vendor-neutral: each cosigner names a VENDOR (registered in the
# BackendRegistry) + its own token + path. Here: one Securosys HSM cosigner and
# one dev SoftHSM cosigner in a single 2-of-2.

# ---- dev SoftHSM shim env (absolute paths; the shim reads these at runtime) ----
SOFTHSM2_LIB=/usr/lib/softhsm/libsofthsm2.so
SOFTHSM2_CONF=/ABSOLUTE/PATH/TO/emvault-core/softhsm2.conf
DEV_HSM_CONFIG=/ABSOLUTE/PATH/TO/emvault-core/dev-hsm-core-tests.toml

# ---- fleet ----
EMVAULT_FLEET_NETWORK=testnet

# cosigner 0 — Securosys CloudHSM
EMVAULT_FLEET_0_VENDOR=securosys
EMVAULT_FLEET_0_LABEL=mv-sec
EMVAULT_FLEET_0_LIB=/usr/lib/libprimusP11.so
EMVAULT_FLEET_0_SLOT=YHRXBOTJLQWT
EMVAULT_FLEET_0_PIN=<securosys-pkcs11-pin>
EMVAULT_FLEET_0_PATH=m/48'/1'/0'/0'
# `seed:<hex>` derives a fresh master from this seed (sandbox); `load` reuses an
# already-provisioned key; `shim` lets the backend supply the seed.
EMVAULT_FLEET_0_KEY=seed:2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a

# cosigner 1 — dev SoftHSM shim (seed supplied by the shim for token `core-test-1`)
EMVAULT_FLEET_1_VENDOR=dev
EMVAULT_FLEET_1_LABEL=mv-dev
EMVAULT_FLEET_1_LIB=/ABSOLUTE/PATH/TO/libemvault_dev_hsm/target/release/libemvault_dev_hsm.so
EMVAULT_FLEET_1_SLOT=core-test-1
EMVAULT_FLEET_1_PIN=<softhsm-user-pin>
EMVAULT_FLEET_1_PATH=m/48'/1'/0'/2'
EMVAULT_FLEET_1_KEY=shim
